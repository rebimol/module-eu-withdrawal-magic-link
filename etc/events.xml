<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        AppendMagicLinkToOrderEmails extends Magento's order-confirmation
        and shipment-notification emails with a one-click "Withdraw from
        contract" CTA carrying a 72h ?t=TOKEN URL. The observer issues
        (or reuses) the token via MagicLinkService and sets template vars
        consumed by the sales_email overrides registered in this module's
        etc/email_templates.xml.

        Lite-only installs neither register this observer nor override the
        sales_email templates — the consumer falls back to Magento's
        vanilla order-confirmation email and exercises Art. 11a(1)
        withdrawal access via the Lite lookup form (one-time
        order_id + email match → session-verified state).
    -->
    <event name="email_order_set_template_vars_before">
        <observer name="mageme_eu_withdrawal_append_magic_link"
                  instance="MageMe\EUWithdrawalMagicLink\Observer\AppendMagicLinkToOrderEmails"/>
    </event>
    <event name="email_shipment_set_template_vars_before">
        <observer name="mageme_eu_withdrawal_append_magic_link_shipment"
                  instance="MageMe\EUWithdrawalMagicLink\Observer\AppendMagicLinkToOrderEmails"/>
    </event>
</config>
