<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mageme_eu_withdrawal>
            <magic_link>
                <!-- Default: enabled when Pro is installed. Merchants who prefer
                     the lookup-form CTA (Art. 11a(1) floor) without uninstalling
                     Pro can toggle this off in Stores → Configuration. -->
                <enabled>1</enabled>
                <!-- Token lifetime in days. Default 30 days covers a typical
                     EU order timeline (shipment + 14-day post-delivery
                     withdrawal window). -->
                <lifetime_days>30</lifetime_days>
            </magic_link>
        </mageme_eu_withdrawal>
    </default>
</config>
