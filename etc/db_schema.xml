<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mm_eu_withdrawal_magic_link" resource="default" engine="innodb" comment="Per-order magic-link tokens (Art. 11a(1) guest access UX upgrade)">
        <column xsi:type="int" name="token_id" unsigned="true" nullable="false" identity="true" comment="PK"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="FK sales_order.entity_id"/>
        <column xsi:type="varchar" name="token_hash" length="64" nullable="false" comment="SHA-256 hex of token"/>
        <column xsi:type="timestamp" name="issued_at" nullable="false" default="CURRENT_TIMESTAMP" comment="When token was generated"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" comment="Absolute TTL (initial 72h)"/>
        <column xsi:type="timestamp" name="first_accessed_at" nullable="true" comment="First click timestamp (starts rolling 24h)"/>
        <column xsi:type="timestamp" name="last_accessed_at" nullable="true" comment="Last click timestamp (extends rolling 24h)"/>
        <column xsi:type="timestamp" name="used_at" nullable="true" comment="When token was consumed (single-use after confirm)"/>
        <column xsi:type="timestamp" name="revoked_at" nullable="true" comment="Admin revocation timestamp"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="token_id"/>
        </constraint>
        <index referenceId="IDX_MM_EU_WITHDRAWAL_MAGIC_LINK_TOKEN_HASH" indexType="btree">
            <column name="token_hash"/>
        </index>
        <index referenceId="IDX_MM_EU_WITHDRAWAL_MAGIC_LINK_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
</schema>
